<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Memory Gift</title>
    <style>
        body { margin: 0; background: #f5efe6; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; }
        .lock-screen { text-align: center; }
        .main-content { display: none; width: 100%; padding: 20px; }
        .card { background: white; padding: 15px; border-radius: 20px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        input { padding: 10px; border-radius: 10px; border: 1px solid #ccc; }
        button { padding: 10px 20px; background: #ff9999; border: none; border-radius: 10px; color: white; cursor: pointer; }
    </style>
</head>
<body>

    <!-- شاشة القفل -->
    <div id="lock" class="lock-screen">
        <div style="font-size: 50px;">🔐</div>
        <input type="password" id="pass" placeholder="أدخل الرمز السري">
        <br><br>
        <button onclick="unlock()">فتح الذكريات</button>
    </div>

    <!-- المحتوى -->
    <div id="main" class="main-content">
        <div class="card">
            <h2>رسالة خاصة</h2>
            <p>هنا تضع الكلمات التي تريدها لها.</p>
        </div>
        
        <!-- مكان إضافة الأغنية -->
        <div class="card">
            <iframe src="رابط_الاغنية_هنا" width="100%" height="80" frameborder="0"></iframe>
        </div>
    </div>

    <script>
        function unlock() {
            if(document.getElementById('pass').value == "1234") {
                document.getElementById('lock').style.display = 'none';
                document.getElementById('main').style.display = 'block';
            } else { alert("رمز خاطئ"); }
        }
    </script>
</body>
</html>
